# ── Provider ──────────────────────────────────────────────────────────────────
# Pick one provider and uncomment its block.  Everything else stays the same;
# all 11 harnesses derive their endpoint+key+model from these three vars:
#
#   PROVIDER_BASE_URL       OpenAI-compatible URL ending in /v1 (most harnesses)
#   PROVIDER_API_KEY        bearer token the provider expects
#   MODEL_NAME              model id in the provider's own format
#
# Anthropic-compatible harnesses (Claude Code, Droid) additionally need:
#   PROVIDER_ANTHROPIC_URL  base URL exposing /v1/messages (typically the same
#                           host without the /v1 suffix)
#
# Most non-NIM providers do not implement Anthropic's /v1/messages surface;
# leave PROVIDER_ANTHROPIC_URL pointing at the same host anyway (the SDK will
# 404 cleanly), and use one of the 11 OpenAI-compat harnesses instead.
#
# Quick verification before relying on a provider:
#   curl -H "Authorization: Bearer $PROVIDER_API_KEY" $PROVIDER_BASE_URL/models
# Make sure the model you picked supports tool/function calling.

# --- NVIDIA NIM (self-hosted) -------------------------------------------------
PROVIDER_BASE_URL=http://nim.example.com:8000/v1
PROVIDER_ANTHROPIC_URL=http://nim.example.com:8000
PROVIDER_API_KEY=nvapi-replace-me
MODEL_NAME=deepseek-ai/deepseek-coder-v2-instruct

# --- OpenRouter (hosted, ~300 models) -----------------------------------------
# PROVIDER_BASE_URL=https://openrouter.ai/api/v1
# PROVIDER_ANTHROPIC_URL=https://openrouter.ai/api
# PROVIDER_API_KEY=sk-or-v1-...
# MODEL_NAME=anthropic/claude-3.5-sonnet

# --- build.nvidia.com (NIM hosted by NVIDIA, free tier) -----------------------
# PROVIDER_BASE_URL=https://integrate.api.nvidia.com/v1
# PROVIDER_ANTHROPIC_URL=https://integrate.api.nvidia.com
# PROVIDER_API_KEY=nvapi-...
# MODEL_NAME=meta/llama-3.1-405b-instruct

# --- Anthropic direct (real Claude — most expensive, best at tool calling) ---
# PROVIDER_BASE_URL=https://api.anthropic.com/v1
# PROVIDER_ANTHROPIC_URL=https://api.anthropic.com
# PROVIDER_API_KEY=sk-ant-...
# MODEL_NAME=claude-3-5-sonnet-20241022

# --- OpenAI direct ------------------------------------------------------------
# PROVIDER_BASE_URL=https://api.openai.com/v1
# PROVIDER_ANTHROPIC_URL=https://api.openai.com
# PROVIDER_API_KEY=sk-...
# MODEL_NAME=gpt-4o

# --- Groq (fast Llama/Mixtral, OpenAI-compat) ---------------------------------
# PROVIDER_BASE_URL=https://api.groq.com/openai/v1
# PROVIDER_ANTHROPIC_URL=https://api.groq.com/openai
# PROVIDER_API_KEY=gsk_...
# MODEL_NAME=llama-3.3-70b-versatile

# --- Together.ai --------------------------------------------------------------
# PROVIDER_BASE_URL=https://api.together.xyz/v1
# PROVIDER_ANTHROPIC_URL=https://api.together.xyz
# PROVIDER_API_KEY=...
# MODEL_NAME=deepseek-ai/DeepSeek-V3

# --- DeepSeek direct ----------------------------------------------------------
# PROVIDER_BASE_URL=https://api.deepseek.com/v1
# PROVIDER_ANTHROPIC_URL=https://api.deepseek.com/anthropic
# PROVIDER_API_KEY=sk-...
# MODEL_NAME=deepseek-chat

# --- Local Ollama (no GPU? use small models like qwen2.5-coder:7b) ------------
# PROVIDER_BASE_URL=http://host.docker.internal:11434/v1
# PROVIDER_ANTHROPIC_URL=http://host.docker.internal:11434
# PROVIDER_API_KEY=ollama
# MODEL_NAME=qwen2.5-coder:7b

# ── Free-model catalog / fallback (OpenRouter only) ───────────────────────────
# The auth service serves a self-updating /v1/models catalog to the harness
# pickers and can inject a `models` fallback array on every request.  Two knobs:
#
#   FREE_FALLBACK=1        On a rate-limit/error, OpenRouter rolls the request
#                          over to the next free model (resilient).  The switch
#                          is transparent: the reply leads with a one-line
#                          "↳ <requested> unavailable → answered by <served>"
#                          notice, the response reports the model that actually
#                          answered, and the proxy logs every switch.  Set 0 to
#                          always use exactly the model you selected (you'll get
#                          a clear error instead of any substitution).
#   FREE_REQUIRE_TOOLS=1   Catalog lists only tool-calling models (needed for
#                          agentic work).  Set 0 to list *every* free model in
#                          the pickers (chat-only models included).
#
# Defaults preserve the resilient/tool-only behaviour.  For a comparison lab
# where you hand-pick each model, set both to 0:
# FREE_FALLBACK=0
# FREE_REQUIRE_TOOLS=0

# ── Domain / cookies ──────────────────────────────────────────────────────────
# All harness subdomains live under this base. Set a *.lab.example.com DNS A
# record pointing at this VPS. Cookies are scoped to the leading dot so a single
# JWT cookie issued at e.g. aider.lab.example.com stays restricted to that host.
HARNESS_BASE_DOMAIN=lab.example.com

# ── Auth ──────────────────────────────────────────────────────────────────────
# Long random string used to sign per-harness JWTs. Rotate by regenerating
# tokens (scripts/generate-tokens.py) — the secret change invalidates all
# existing tokens immediately.
JWT_SECRET=replace-me-with-a-long-random-string

# ── Session longevity ─────────────────────────────────────────────────────────
# The browser cookie holds a SESSION token minted at login, not the TOKEN_*
# below: logging in on any subdomain starts a fresh SESSION_TTL_DAYS window,
# and the auth service re-mints (slides) the cookie once less than
# SESSION_REFRESH_DAYS of that window remain — so a session in regular use
# never lapses. Both are days.
SESSION_TTL_DAYS=360
SESSION_REFRESH_DAYS=30

# all     → the session covers EVERY subdomain under HARNESS_BASE_DOMAIN
#           (all harnesses, every <harness>-<slug> session, and files) — one
#           login for the whole lab. This is the single-operator default.
# harness → the session stays pinned to the harness it was minted on, so a
#           login on claude.<domain> does not unlock files.<domain>.
SESSION_SCOPE=all

# Idle timeout (minutes) before the auth service stops a harness container.
# Set to 0 to disable auto-stop.  300 = 5 hours.
IDLE_TIMEOUT_MIN=300

# Seconds the auth service waits for a cold-starting harness to start
# listening before giving up with a 504. Must cover the SLOWEST harness boot:
# claude's entrypoint registers ~26 MCP servers before it execs ttyd, which
# can take over a minute.
COLD_START_TIMEOUT_S=120

# Harness types the idle sweep must NEVER stop (comma-separated, e.g.
# "claude,opencode"). Stopping a container kills its tmux server and every CLI
# session running inside it — a conversation you left open is gone on the next
# visit even though the cookie is still valid. Exempt the harnesses you
# actually keep long-running work in; leave empty to sweep everything.
IDLE_EXEMPT=

# Max dynamic instances (claude-<slug>, aider-<slug>, …) allowed to run in
# parallel per harness type.  The always-on base harness is not counted.
# Set to 0 for unlimited.  A request for a (cap+1)th distinct slug is rejected.
MAX_INSTANCES_PER_HARNESS=5

# Days of inactivity before an unpinned dynamic session (<harness>-<slug>) is
# torn down by the retention sweep. Pin a session (POST /pin) to exempt it.
RETENTION_DAYS=7

# ── Per-harness JWTs (regenerate with scripts/generate-tokens.py) ─────────────
TOKEN_CLAUDE=
TOKEN_AIDER=
TOKEN_OPENCODE=
TOKEN_CRUSH=
TOKEN_GPTME=
TOKEN_GOOSE=
TOKEN_PLANDEX=
TOKEN_QWENCODE=
TOKEN_CODEX=
TOKEN_PI=
TOKEN_DROID=
# Not a CLI harness — the always-on file-manager web UI at files.<domain>.
TOKEN_FILES=

# ─── Folio MCP server (optional) ────────────────────────────────────────────
# Connects the harnesses to an external Folio MCP instance. Leave blank to
# disable. Each harness entrypoint registers it in its native MCP config format.
FOLIO_MCP_URL=https://folio.your-domain.tld/mcp
FOLIO_MCP_TOKEN=sk-folio-...

# ─── Web search/fetch MCP (DuckDuckGo, free, no API key) ────────────────────
# Always-on sidecar (service web-mcp) on harnesses_net. Every harness registers
# this URL in its native MCP config. No token. Leave blank to disable.
WEB_MCP_URL=http://web-mcp:7070/mcp
# DDG_SAFE_SEARCH=MODERATE   # STRICT | MODERATE | OFF

# ─── MCP_* self-hosted tool servers (optional, 6 repos) ─────────────────────
# github.com/azzindani/MCP_{Math,Web_Browser,File_System,Machine_Learning,
# Data_Analyst,Microsoft_Office} — each deployed standalone, bearer-token
# auth, registered the same env-var-gated way as Folio/web above. Leave a
# pair blank to disable that repo entirely. Math/Browser/File_System expose
# one endpoint each; Machine_Learning/Data_Analyst/Microsoft_Office mount
# several sub-servers with no single unified endpoint, so their var is the
# BASE url (no /mcp suffix) and each harness entrypoint registers every
# sub-server under it individually.
MATH_MCP_URL=https://math.casava.space/mcp
MATH_MCP_TOKEN=sk-math-...

# Browser automation (fetch/extract/search) — distinct from the bundled
# DuckDuckGo `web` sidecar above.
BROWSER_MCP_URL=https://browser.casava.space/mcp
BROWSER_MCP_TOKEN=sk-browser-...

FS_MCP_URL=https://fs.casava.space/mcp
FS_MCP_TOKEN=sk-fs-...

# 3 sub-servers: basic, medium, advanced.
ML_MCP_BASE_URL=https://ml.casava.space
ML_MCP_TOKEN=sk-ml-...

# 7 sub-servers: basic, medium, statistics, transform, visual, workspace, ingest.
DATA_MCP_BASE_URL=https://data.casava.space
DATA_MCP_TOKEN=sk-data-...

# 11 sub-servers: docx-{basic,tables,layout,new}, xlsx-{basic,formulas,charts,new},
# pptx-{basic,design,new}.
OFFICE_MCP_BASE_URL=https://office.casava.space
OFFICE_MCP_TOKEN=sk-office-...
